# Runtime data and logs
logs/*
!logs/.gitkeep
output/*
!output/.gitkeep
outputs/*
!outputs/.gitkeep
uploads/*
!uploads/.gitkeep
storage/*
!storage/.gitkeep
temp/*
!temp/.gitkeep
database/*
!database/.gitkeep

# Local secrets and user configuration
config/ai_config.json
.env
.env.*
!.env.example
*.sqlite
*.sqlite3
*.db
*.db-*
credentials*.json
censor_words.json

# Private Anna partnership files: never publish these to the open-source repository.
app.json
manifest.json
bundle/
executas/
.anna/
jjyb_wsl/
*.vhdx
*.vhdx.lock
.github/workflows/build-executa-linux.yml

# Python caches and test output
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# Virtual environments and build output
.venv/
venv/
env/
build/
dist/
release/
*.egg-info/

